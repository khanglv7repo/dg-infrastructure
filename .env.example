COMPOSE_PROJECT_NAME=dg
DOCKER_NETWORK_NAME=dg-net
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
OPENMETADATA_VERSION=2.0.2
OPENMETADATA_DB=openmetadata_db
OPENMETADATA_DB_USER=openmetadata_user
OPENMETADATA_DB_PASSWORD=
FINANCIAL_DB=financial_db
TRINO_DB_USER=trino_reader
TRINO_DB_PASSWORD=

# TASK-10: Backend/Agent database separation (docs/DG_FINAL_SPEC.md section 12.1
# governance-app owns its own least-privilege DB/role instead of connecting as
# the Postgres superuser). Created idempotently by
# docker/postgres-init/01-init.sh only when GOVERNANCE_DB does not already exist
# -- it will never touch or reassign an existing governance_db created before
# this variable was introduced.
GOVERNANCE_DB=governance_db
GOVERNANCE_DB_USER=governance_db_user
GOVERNANCE_DB_PASSWORD=

# TASK-10: dedicated Agent LangGraph checkpointer Postgres database, per
# docs/DG_FINAL_SPEC.md section 10 ("không chung" -- explicitly not shared with
# Backend's governance_db). BLOCKED per planning/03-CODE-EDIT-MANIFEST.md's
# Agent "Checkpoint persistence" row until this is provisioned; declared here so
# TASK-09 has something real to wire against once it resumes checkpointer work.
AGENT_CHECKPOINT_DB=agent_checkpoint_db
AGENT_CHECKPOINT_DB_USER=agent_checkpoint_db_user
AGENT_CHECKPOINT_DB_PASSWORD=

RANGER_VERSION=2.8.0
RANGER_DB_USER=rangeradmin
RANGER_DB_PASSWORD=
RANGER_DB_HOST_PORT=5433
TRINO_VERSION=482

# Ranger bootstrap job (runs idempotently when creating/recreating the stack)
RANGER_BOOTSTRAP_USER=admin
RANGER_BOOTSTRAP_PASSWORD=rangerR0cks!
RANGER_INIT_TIMEOUT_SECONDS=300
TRINO_SERVICE_NAME=dev_trino

# OpenMetadata external ingestion — use the JWT copied from Settings > Bots > ingestion-bot
OM_INGESTION_BOT_TOKEN=
INGESTION_SERVICE_NAME=financial_postgres
INGESTION_INTERVAL_SECONDS=3600

# OpenMetadata semantic search embeddings (OpenMetadata 2.0.2 llmConfiguration).
# Required when EMBEDDING_PROVIDER=openai in docker-compose.yml. Do not commit a real key.
LLM_OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL_ID=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSION=1536

# Redis (used by Backend Celery workers)
REDIS_URL=redis://redis:6379/0
