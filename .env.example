COMPOSE_PROJECT_NAME=dg
DOCKER_NETWORK_NAME=dg-net
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=
OPENMETADATA_VERSION=1.13.1
OPENMETADATA_DB=openmetadata_db
OPENMETADATA_DB_USER=openmetadata_user
OPENMETADATA_DB_PASSWORD=
FINANCIAL_DB=financial_db
TRINO_DB_USER=trino_reader
TRINO_DB_PASSWORD=
RANGER_VERSION=2.8.0
RANGER_DB_USER=rangeradmin
RANGER_DB_PASSWORD=
RANGER_DB_HOST_PORT=5433
TRINO_VERSION=482

# Ranger bootstrap job (runs idempotently when creating/recreating the stack)
RANGER_BOOTSTRAP_USER=admin
RANGER_BOOTSTRAP_PASSWORD=rangerR0cks!
RANGER_INIT_TIMEOUT_SECONDS=300
TRINO_SERVICE_NAME=dev_trino

# OpenMetadata external ingestion — use the JWT copied from Settings > Bots > ingestion-bot
OM_INGESTION_BOT_TOKEN=
INGESTION_SERVICE_NAME=financial_postgres
INGESTION_INTERVAL_SECONDS=3600
